# Combined reference only. Prefer frontend/.env.example and backend/.env.example for local setup.
# Use the Project URL and publishable key from your own Supabase project.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend only. Never prefix server-only secrets with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
CORS_ORIGINS=http://localhost:3000

# Optional. Leave disabled until the user opts in in the UI.
AI_SUMMARY_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
