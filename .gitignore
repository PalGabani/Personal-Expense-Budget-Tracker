# ---------------------------------------------------------------------------
# Secrets and environment
# ---------------------------------------------------------------------------
# Real credentials must never be committed. Patterns without a leading slash
# match at any depth, so these cover ./.env, backend/.env and frontend/.env.local.
.env
.env.*
.envrc
!.env.example
!.env.*.example

# Keys and credential files
*.pem
*.key
*.p12
*.pfx
*.jks
service-account*.json
service-role*.json
firebase-adminsdk*.json
secrets.json

# ---------------------------------------------------------------------------
# Python / FastAPI
# ---------------------------------------------------------------------------
# Virtual environments
.venv/
venv/
env/
ENV/

# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build
build/
dist/
*.egg-info/
*.egg
pip-wheel-metadata/

# Test, lint and type caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.pyre/
.hypothesis/

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml

# ---------------------------------------------------------------------------
# Node / Next.js
# ---------------------------------------------------------------------------
node_modules/
.npm/
.yarn/
.pnpm-store/

.next/
out/
.turbo/
.vercel/
next-env.d.ts

# Test and type caches
coverage/
*.tsbuildinfo
*.tsxbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pnpm-lock.yaml

# ---------------------------------------------------------------------------
# Supabase CLI
# ---------------------------------------------------------------------------
supabase/.temp/
**/service-role*.json
.branches/
.worktrees/

# ---------------------------------------------------------------------------
# Editor and operating system
# ---------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
.project
.settings/

# ---------------------------------------------------------------------------
# Miscellaneous
# ---------------------------------------------------------------------------
*.log
*.pid
*.bak
*.orig
*.rej
.cache/
